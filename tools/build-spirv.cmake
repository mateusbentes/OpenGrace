# Builds the SPIR-V for the Vulkan backend's shader library.
#
# The library's GLSL 450 sources are extracted per shader, compiled to SPIR-V
# by glslangValidator (the build-time prerequisite, decision 44), and the
# generated header carries the per-shader byte arrays. The backend's
# VkShaderProgram resolves through the same enum order as the library.
#
# The broken pair (kBrokenVertexShader / kBrokenFragmentShader) is
# deliberately invalid: its compilation is expected to fail and the failure
# is recorded in the generated header (an empty array), so the backend's
# violation-count test observes the same behaviour the OpenGL library
# documents.
#
# Run from the CMakeLists.txt:
#   cmake -DSOURCE_DIR=... -DGENERATED_DIR=...
#         -DGLSLANG=... -P tools/build-spirv.cmake
cmake_minimum_required(VERSION 3.15)

set(GLSLANG "" CACHE STRING "path to the glslangValidator executable")
if(NOT GLSLANG)
    message(FATAL_ERROR "glslangValidator not found; the Vulkan backend's "
        "SPIR-V step needs it (decision 44)")
endif()

# Extract the shader sources from the library header.
file(READ "${SOURCE_DIR}/src/render/vulkan/vulkan_shader_library.hpp"
    LIBRARY_TEXT)

# The shader names in the order the library declares them.
string(REGEX MATCHALL "constexpr const char\\* [A-Za-z0-9_]+"
    SHADER_NAMES "${LIBRARY_TEXT}")
list(TRANSFORM SHADER_NAMES REPLACE
    "constexpr const char\\* " "")

# Extract the raw string literal body of each shader.
set(GENERATED "// The Vulkan backend's compiled SPIR-V library. Generated by")
string(APPEND GENERATED " tools/build-spirv.cmake\n")
string(APPEND GENERATED
    "// from the GLSL 450 sources in vulkan_shader_library.hpp\n")
string(APPEND GENERATED
    "// (decision 44: glslangValidator is the build-time prerequisite).\n")
string(APPEND GENERATED "#pragma once\n\n")
string(APPEND GENERATED
    "#include <cstdint>\n\n")
string(APPEND GENERATED
    "namespace grace::render::vulkan {\n\n")
set(SPIRV_OK "")
set(SPIRV_EMPTY "")
foreach(NAME ${SHADER_NAMES})
    # The stage: the vertex shader's stage is the vertex one; the fragment
    # shader's stage is the fragment one.
    if(NAME MATCHES "VertexShader")
        set(STAGE "vert")
    elseif(NAME MATCHES "FragmentShader")
        set(STAGE "frag")
    else()
        message(FATAL_ERROR "unknown shader stage: ${NAME}")
    endif()
    # The raw string literal body between the marker and the closing.
    string(REGEX MATCH
        "${NAME} = R\"\\((.*?)\n\\)\""
        SHADER_BODY "${LIBRARY_TEXT}")
    if(NOT SHADER_BODY)
        message(FATAL_ERROR "shader ${NAME} not found in the library")
    endif()
    # The body is the first capture group.
    string(REGEX REPLACE "${NAME} = R\"\\(" "" SHADER_BODY "${SHADER_BODY}")
    string(REGEX REPLACE "\n\\)\"$" "" SHADER_BODY "${SHADER_BODY}")
    # The stage file is the shader's source, written to the build tree.
    set(STAGE_FILE "${CMAKE_CURRENT_BINARY_DIR}/shader_${NAME}.${STAGE}")
    file(WRITE "${STAGE_FILE}" "${SHADER_BODY}\n")
    # The SPIR-V file is the compiled result.
    set(SPIRV_FILE "${CMAKE_CURRENT_BINARY_DIR}/shader_${NAME}.spv")
    execute_process(
        COMMAND "${GLSLANG}" -V "${STAGE_FILE}" -o "${SPIRV_FILE}"
        RESULT_VARIABLE RESULT
        OUTPUT_VARIABLE OUTPUT
        ERROR_VARIABLE OUTPUT
        )
    if(NOT RESULT EQUAL 0)
        # The broken pair is expected to fail; the array is empty and the
        # backend's violation-count test observes the same failure the
        # OpenGL library documents.
        string(APPEND SPIRV_EMPTY
            "constexpr std::uint32_t k${NAME}Spirv[] = {};\n")
        message(STATUS "shader ${NAME} failed to compile (expected for the"
            " broken pair)")
        continue()
    endif()
    file(READ "${SPIRV_FILE}" SPIRV_TEXT HEX)
    # The SPIR-V is a binary: split into 4-byte words and emit the array.
    string(REGEX MATCHALL "([0-9a-f][0-9a-f]){4}" WORDS "${SPIRV_TEXT}")
    list(LENGTH WORDS WORD_COUNT)
    string(APPEND GENERATED "constexpr std::uint32_t k${NAME}Spirv[] = {\n")
    set(I 0)
    foreach(WORD ${WORDS})
        math(EXPR I "${I} + 1")
        if(I EQUAL WORD_COUNT)
            string(APPEND GENERATED "    0x${WORD}u")
        else()
            string(APPEND GENERATED "    0x${WORD}u,")
        endif()
        if(I MOD 4 EQUAL 0)
            string(APPEND GENERATED "\n")
        endif()
    endforeach()
    string(APPEND GENERATED "};\n")
    string(APPEND GENERATED
        "constexpr std::uint32_t k${NAME}SpirvWords = ${WORD_COUNT};\n")
    string(APPEND SPIRV_OK "${NAME} ")
    list(APPEND SPIRV_OK_LIST "${NAME}")
endforeach()
string(APPEND GENERATED
    "}  // namespace grace::render::vulkan\n")
file(WRITE "${GENERATED_DIR}/vulkan_spirv.hpp" "${GENERATED}")
message(STATUS "SPIR-V library written to ${GENERATED_DIR}/vulkan_spirv.hpp")
